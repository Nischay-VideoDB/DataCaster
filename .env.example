# VideoDB credentials
VIDEO_DB_API_KEY=your-api-key-here

# Sandbox routing.
#   USE_SANDBOX=true   → allocate a hackathon sandbox per session.
#                        Routes coll.generate_voice through it; LLM Ask /
#                        recap pick model_name="ultra" (server-side, not
#                        sandbox-routed).
#   SANDBOX_TIER=small ($1/hr, 4 slots) — recommended; medium ($3.50/hr,
#                        3 slots) provisioning is occasionally flaky.
#   USE_SANDBOX=false  → skip the sandbox layer entirely; LLM falls back
#                        to model_name="basic".
USE_SANDBOX=true
SANDBOX_TIER=small

# RTStream-only model overrides (rt.index_visuals takes a real model id;
# small-tier multimodal is gemma-4-E2B-it). VOD path uses VideoDB defaults.
VISUAL_MODEL=google/gemma-4-E2B-it
AUDIO_MODEL=Qwen/Qwen3.5-9B
VOICE_MODEL=k2-fsa/OmniVoice

# Default test source for /api/start. Set ONE of the three:
#
# Option A — Live RTSP/RTMP URL (no local infra needed)
# DEFAULT_SOURCE_TYPE=url
# DEFAULT_SOURCE=rtsp://your-broadcast/live/match
#
# Option B — YouTube URL (VOD; goes through coll.upload(media_type=video))
#
# Option C — Public RTSP sample feed (default; the bundled UI preset)
DEFAULT_SOURCE_TYPE=url
DEFAULT_SOURCE=rtsp://samples.rts.videodb.io:8554/crib

# Telegram delivery for the Highlight Reel feature.
# Both vars must be set to enable Telegram posting; otherwise the reel
# composes + returns to the UI but no message is sent.
#
# 1. Open Telegram, message @BotFather, run /newbot, copy the token.
# 2. Open a chat with the bot (or add it to a group), send any message,
#    then visit https://api.telegram.org/bot<TOKEN>/getUpdates and copy
#    the numeric "chat":{"id":…}. Or DM @userinfobot for your personal id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
